{
  "name": "zunion-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:vercel": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/migrate.ts",
    "seed:users": "tsx src/seed.ts",
    "reset:passwords": "tsx src/reset-all-passwords.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "nodemailer": "7.0.11",
    "pg": "8.16.3",
    "resend": "^6.17.2",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "25.0.3",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.16.0",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
