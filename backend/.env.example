NODE_ENV=development
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# Modern Supabase pooler (host db.<ref>.supabase.co) — user postgres or postgres.<ref>.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true
COOKIE_SECRET=change-this-long-random-secret
SESSION_COOKIE_NAME=zunion_session
UPLOAD_DIR=/app/uploads
OTP_DEV_MODE=true
RESEND_API_KEY=
# Development/testing can use onboarding@resend.dev. Production should use a sender on a verified Resend domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM="Zunion <onboarding@resend.dev>"
PASSWORD_CHANGE_EMAIL=mahmoud_foly@icloud.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zunion <no-reply@zunion.local>"
